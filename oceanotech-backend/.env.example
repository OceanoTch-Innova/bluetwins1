# Copia este archivo a ".env" y cambia todos los valores antes de correr en producción.

PORT=4000
NODE_ENV=development

# Origen(es) permitidos para CORS, separados por coma (ej: la URL donde vive tu login.html)
CORS_ORIGIN=http://localhost:5500

# Directorio/archivo SQLite. En producción, usa almacenamiento persistente.
# DB_PATH=

# Supabase Auth: URL HTTPS del proyecto y clave publishable. No uses service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# JWT de acceso Piscis (64 bytes aleatorios):
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=cambia_este_valor_por_uno_largo_y_aleatorio
# Clave AES-256 de cifrado (32 bytes aleatorios; 64 caracteres hexadecimales):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PISCIS_REFRESH_ENCRYPTION_KEY=

# JWT_REFRESH_SECRET ya no se usa para nuevas sesiones Piscis; se conserva
# sólo para instalaciones antiguas mientras se completa su revocación.
# JWT_REFRESH_SECRET=

# Política de bloqueo de cuenta por intentos fallidos
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- reCAPTCHA heredado (el login local está deshabilitado) ---
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ENABLED=false

# Opcional: cuenta demo heredada sólo si se configuran valores propios.
# DEMO_USER_EMAIL=
# DEMO_USER_PASSWORD=
