# Copy to .env.integration.local. Values below are deliberately fictitious.
# Do not enable this runner until all project references and accounts are confirmed
# to belong to a dedicated, non-production Supabase test project.
SUPABASE_INTEGRATION_ENABLED=NO
SUPABASE_TEST_PROJECT_APPROVAL=NOT_CONFIRMED
SUPABASE_TEST_PROJECT_REF=replace_with_dedicated_test_project_ref
SUPABASE_URL=https://replace_with_dedicated_test_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_TEST_PROJECT_KEY

# Pre-create both accounts manually in the dedicated test project.
# The first account must also be provisioned into the temporary Piscis database
# by the runner; the second account is intentionally not provisioned there.
SUPABASE_TEST_AUTHORIZED_EMAIL=authorized@example.invalid
SUPABASE_TEST_AUTHORIZED_PASSWORD=REPLACE_WITH_TEST_ACCOUNT_PASSWORD
SUPABASE_TEST_UNPROVISIONED_EMAIL=unprovisioned@example.invalid
SUPABASE_TEST_UNPROVISIONED_PASSWORD=REPLACE_WITH_SECOND_TEST_ACCOUNT_PASSWORD
